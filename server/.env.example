# Required — get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Required — create a $3.99/month recurring price in Stripe Dashboard,
# then paste the price ID here (looks like price_...)
STRIPE_PRICE_ID=price_...

# Optional — defaults to 3000
PORT=3000

# Required — the public URL of this server (your Replit app URL, no trailing slash)
# Used to build success_url and cancel_url for Stripe checkout
APP_URL=https://extension-paywall.replit.app

# Optional — additional comma-separated origins allowed to call the API.
# chrome-extension:// origins are always allowed for the extension popup.
# Example: https://extension-paywall.replit.app,https://yourdomain.com
ALLOWED_ORIGINS=
